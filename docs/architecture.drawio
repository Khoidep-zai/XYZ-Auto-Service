        <mxCell id="arr_sec_ctrl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D97706;endArrow=classic;" edge="1" parent="1" source="layer_sec" target="layer_ctrl">
          <mxGeometry relative="1" as="geometry" />
