        <mxCell id="arr_ctrl_srv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4F46E5;endArrow=classic;" edge="1" parent="1" source="layer_ctrl" target="layer_srv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_srv_repo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;endArrow=classic;" edge="1" parent="1" source="layer_srv" target="layer_repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="arr_repo_db" value="HikariCP Connection Pool (Auto-switch Profile dev / postgres)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#059669;endArrow=classic;" edge="1" parent="1" source="layer_repo" target="grp_db">
