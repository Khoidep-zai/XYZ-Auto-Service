        <!-- INDEX NOTES -->
        <mxCell id="note_indexes" value="CHỈ MỤC TỐC ĐỘ CAO (INDEXES):&#xa;• idx_appointment_slot: (booking_date, slot, status) → Tối ưu hóa kiểm tra công suất tức thời&#xa;• idx_appointment_customer: (customer_id) → Tối ưu hóa tra cứu lịch sử cá nhân" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FEF3C7;strokeColor=#D97706;size=16;align=left;fontSize=11;spacingLeft=5;" vertex="1" parent="1">
