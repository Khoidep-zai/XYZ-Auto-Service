        <mxCell id="title" value="MÔ HÌNH THỰC THỂ MỐI QUAN HỆ (ERD - CHUẨN HÓA 3NF) — CƠ SỞ DỮ LIỆU POSTGRESQL" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=15;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="730" height="30" as="geometry" />
        </mxCell>

        <!-- TABLE: workshop_accounts -->
        <mxCell id="tbl_accounts" value="workshop_accounts&#xa;─────────────────────────────────────&#xa;PK  id            : BIGSERIAL&#xa;UQ  phone         : VARCHAR(20)&#xa;    name          : VARCHAR(100)&#xa;    password_hash : VARCHAR(255)&#xa;    role          : VARCHAR(16)&#xa;    meta          : VARCHAR(200)" style="shape=swimlane;fontStyle=1;align=left;startSize=26;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
