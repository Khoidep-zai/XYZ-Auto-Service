        <!-- RELATIONSHIP: accounts -> appointments (1 - N) -->
        <mxCell id="rel_acc_appt" value="1        đặt lịch        0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#2563EB;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="tbl_accounts" target="tbl_appointments">
