        <!-- TABLE: workshop_appointment_services -->
        <mxCell id="tbl_appt_services" value="workshop_appointment_services&#xa;─────────────────────────────────────&#xa;FK  appointment_id   : BIGINT&#xa;    service_code     : VARCHAR(32)&#xa;    service_name     : VARCHAR(150)&#xa;    service_price    : BIGINT&#xa;    service_duration : INT" style="shape=swimlane;fontStyle=1;align=left;startSize=26;html=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="480" width="260" height="130" as="geometry" />
