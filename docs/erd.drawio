        <mxCell id="rel_appt_services" value="1        chứa        1..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="tbl_appointments" target="tbl_appt_services">
