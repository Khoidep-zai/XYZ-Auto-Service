<mxfile host="app.diagrams.net" modified="2026-11-01T13:32:00.000Z" agent="Antigravity" version="21.6.8" type="device">
  <diagram id="arch-diagram" name="System Architecture (Clean Architecture)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="SƠ ĐỒ KIẾN TRÚC PHẦN MỀM CLEAN LAYERED MONOLITH — XYZ AUTO SERVICE" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=15;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="670" height="30" as="geometry" />
        </mxCell>

        <!-- CLIENT BROWSER -->
        <mxCell id="grp_client" value="CLIENT TIER (WEB BROWSERS - DESKTOP &amp; MOBILE)" style="shape=swimlane;fontStyle=1;align=center;startSize=26;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="1010" height="120" as="geometry" />
        </mxCell>

        <mxCell id="comp_spa" value="Single Page Application (SPA)&#xa;• HTML5 Responsive UI&#xa;• Tailwind CSS Design System&#xa;• Vanilla JS State Machine (app.js)&#xa;• FontAwesome Local Icons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontStyle=0;align=left;spacingLeft=10;" vertex="1" parent="grp_client">
          <mxGeometry x="40" y="40" width="280" height="65" as="geometry" />
        </mxCell>

        <mxCell id="comp_auth_client" value="Client Security Handler&#xa;• CSRF Token Refresher&#xa;• Session Cookie Preserver&#xa;• XSS HTML Input Sanitizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontStyle=0;align=left;spacingLeft=10;" vertex="1" parent="grp_client">
          <mxGeometry x="370" y="40" width="280" height="65" as="geometry" />
        </mxCell>

        <mxCell id="comp_views" value="Core Views / Role Panels&#xa;• Customer Booking &amp; Tracking&#xa;• Staff Workshop Dispatching&#xa;• Manager Admin &amp; Stats Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontStyle=0;align=left;spacingLeft=10;" vertex="1" parent="grp_client">
          <mxGeometry x="700" y="40" width="270" height="65" as="geometry" />
        </mxCell>

        <!-- SERVER CONTAINER -->
        <mxCell id="grp_server" value="APPLICATION TIER (SPRING BOOT 4.x - JAVA 21 LTS RUNTIME)" style="shape=swimlane;fontStyle=1;align=center;startSize=26;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="1010" height="420" as="geometry" />
        </mxCell>

        <!-- 1. Security Filter Chain -->
        <mxCell id="layer_sec" value="SECURITY LAYER (Spring Security Filter Chain)&#xa;• FormLogin (/api/login: phone + password) | Logout (/api/logout)&#xa;• SessionManagement (HttpOnly, SameSite=Lax, Session Fixation Protection)&#xa;• CsrfTokenFilter (X-CSRF-TOKEN validation for POST/PUT)&#xa;• Method Security (@EnableMethodSecurity, @PreAuthorize)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="grp_server">
          <mxGeometry x="40" y="40" width="930" height="65" as="geometry" />
        </mxCell>

        <!-- 2. Controller Layer -->
        <mxCell id="layer_ctrl" value="PRESENTATION / API LAYER (WorkshopController &amp; Errors)&#xa;• REST Endpoints: /api/csrf, /api/state, /api/appointments, /api/services, /api/capacity&#xa;• Input Validation: @Valid ApiModels (AccountInput, BookingInput, RescheduleInput)&#xa;• Global Exception Handling: @RestControllerAdvice (Vietnamese error format)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#4F46E5;strokeWidth=1.5;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="grp_server">
          <mxGeometry x="40" y="130" width="930" height="65" as="geometry" />
        </mxCell>

        <!-- 3. Business Service Layer -->
        <mxCell id="layer_srv" value="BUSINESS LOGIC LAYER (WorkshopService - ACID Transactions)&#xa;• Pessimistic Lock (SELECT FOR UPDATE) on Settings: Zero-Collision Concurrency&#xa;• Schedule Validation (No-Sunday, 8 Slots, Anti-past, Single Car Per Slot)&#xa;• Price &amp; Service Duration Snapshotting&#xa;• State Machine: PENDING → CONFIRMED → IN_PROGRESS → COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="grp_server">
          <mxGeometry x="40" y="220" width="930" height="75" as="geometry" />
        </mxCell>

        <!-- 4. Persistence Layer -->
        <mxCell id="layer_repo" value="DATA ACCESS LAYER (Spring Data JPA Repositories &amp; Hibernate ORM)&#xa;• AccountRepository (findByPhone) | ServiceRepository (findAllActive)&#xa;• AppointmentRepository (lockById, findByDateAndSlot, countBySlot)&#xa;• SettingsRepository (lockSettings @Lock PESSIMISTIC_WRITE)&#xa;• Entities: WorkshopAccount, WorkshopService, WorkshopAppointment, WorkshopSettings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="grp_server">
          <mxGeometry x="40" y="320" width="930" height="75" as="geometry" />
        </mxCell>

        <!-- DATABASE TIER -->
        <mxCell id="grp_db" value="DATABASE TIER (DUAL PROFILE ARCHITECTURE)" style="shape=swimlane;fontStyle=1;align=center;startSize=26;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#059669;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="690" width="1010" height="110" as="geometry" />
        </mxCell>

        <mxCell id="db_postgres" value="PostgreSQL 14+ / 18&#xa;(Profile: postgres - Port 5433/5432)&#xa;• 3NF Relational Tables&#xa;• High-performance Indexes&#xa;• UTF-8 Vietnamese Collation" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="grp_db">
          <mxGeometry x="120" y="35" width="260" height="65" as="geometry" />
        </mxCell>

        <mxCell id="db_h2" value="H2 In-Memory Database&#xa;(Profile: dev - 1-Click Run)&#xa;• PostgreSQL Mode Emulation&#xa;• Zero-Configuration Startup&#xa;• Auto-seeded Default Accounts" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="grp_db">
          <mxGeometry x="630" y="35" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- ARROWS BETWEEN TIERS -->
        <mxCell id="arr_c_s" value="HTTPS / JSON / Session Cookie / X-CSRF-TOKEN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0284C7;endArrow=classic;" edge="1" parent="1" source="grp_client" target="layer_sec">
          <mxGeometry relative="1" as="geometry" />
