        </mxCell>

        <!-- TABLE: workshop_settings -->
        <mxCell id="tbl_settings" value="workshop_settings&#xa;─────────────────────────────────────&#xa;PK  id       : BIGINT = 1&#xa;    capacity : INT DEFAULT 3" style="shape=swimlane;fontStyle=1;align=left;startSize=26;html=1;whiteSpace=wrap;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- TABLE: workshop_services -->
        <mxCell id="tbl_services" value="workshop_services&#xa;─────────────────────────────────────&#xa;PK  id          : VARCHAR(32)&#xa;    name        : VARCHAR(150)&#xa;    category    : VARCHAR(100)&#xa;    duration    : INT (phút)&#xa;    price       : BIGINT (VNĐ)&#xa;    warranty    : VARCHAR(100)&#xa;    description : VARCHAR(1000)&#xa;    checklist   : VARCHAR(2000)&#xa;    active      : BOOLEAN DEFAULT TRUE" style="shape=swimlane;fontStyle=1;align=left;startSize=26;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="100" width="240" height="200" as="geometry" />
        </mxCell>

        <!-- TABLE: workshop_appointments -->
        <mxCell id="tbl_appointments" value="workshop_appointments&#xa;─────────────────────────────────────&#xa;PK  id             : BIGSERIAL&#xa;FK  customer_id    : BIGINT (NULLABLE)&#xa;    customer_name  : VARCHAR(100)&#xa;    phone          : VARCHAR(20)&#xa;    license_plate  : VARCHAR(30)&#xa;    car_model      : VARCHAR(100)&#xa;    booking_date   : DATE&#xa;    slot           : VARCHAR(5)&#xa;    status         : VARCHAR(20)&#xa;    total_duration : INT&#xa;    total_price    : BIGINT&#xa;    bay            : VARCHAR(120)&#xa;    technician     : VARCHAR(120)&#xa;    note           : VARCHAR(1000)&#xa;    staff_note     : VARCHAR(1000)" style="shape=swimlane;fontStyle=1;align=left;startSize=26;html=1;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
